---
/** Delegerad "lägg till"-hantering för menyraderna på en sida. */
---
<script>
  import { laggTill } from '../lib/cart';

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-lagg-till]');
    if (!btn) return;
    const rad = btn.closest<HTMLElement>('[data-menyrad]');
    const id = rad?.dataset.rattId;
    if (!rad || !id) return;

    const select = rad.querySelector<HTMLSelectElement>('[data-tillval]');
    if (select && !select.value) {
      select.classList.add('behover-val');
      select.focus();
      select.addEventListener('change', () => select.classList.remove('behover-val'), { once: true });
      return;
    }

    laggTill(id, select?.value || undefined);

    btn.classList.add('tillagd');
    btn.textContent = '✓';
    setTimeout(() => {
      btn.classList.remove('tillagd');
      btn.textContent = '+';
    }, 800);
  });
</script>
