---
/**
 * Ordmärket satt i ren typografi. Spärrad versal i medelvikt – lugnare
 * än en tung display-logotyp och passar den nordiska hållningen.
 * TODO: ersätt med riktig SVG från ägaren när den finns.
 */
interface Props {
  variant?: 'rad' | 'staplad';
  class?: string;
}
const { variant = 'rad', class: klass = '' } = Astro.props;
---
{variant === 'rad' ? (
  <span class:list={['inline-flex items-baseline gap-2.5', klass]}>
    <span class="text-[0.95rem] font-semibold tracking-[0.18em] uppercase">Joe's Bar</span>
    <span class="hidden text-[0.6rem] tracking-[0.2em] uppercase text-muted min-[420px]:inline">Järna</span>
  </span>
) : (
  <span class:list={['inline-flex flex-col gap-1.5', klass]}>
    <span class="text-lg font-semibold tracking-[0.18em] uppercase">Joe's Bar</span>
    <span class="text-[0.65rem] tracking-[0.2em] uppercase text-muted">Mat &amp; dryck · Järna</span>
  </span>
)}
