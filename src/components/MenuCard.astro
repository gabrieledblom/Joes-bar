---
import type { MenyRatt } from '../config/menu';

interface Props {
  ratt: MenyRatt;
  /** Fördröjning i ms för staggered scroll-reveal */
  fordrojning?: number;
}
const { ratt, fordrojning = 0 } = Astro.props;
const selectId = `tillval-${ratt.id}`;
---
<article
  class="kort flex flex-col overflow-hidden rounded-[var(--brand-radius-kort)] border-2 border-black bg-white text-black transition-[transform,background-color,color] duration-200 hover:-translate-y-1 hover:bg-black hover:text-white motion-reduce:transition-none motion-reduce:hover:translate-y-0"
  data-menykort
  data-ratt-id={ratt.id}
  data-reveal
  style={fordrojning ? `--fordrojning: ${fordrojning}ms` : undefined}
>
  <div class="checker h-2.5" style="--checker-storlek: 10px" aria-hidden="true"></div>
  <div class="flex grow flex-col gap-2.5 p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-display text-xl tracking-wide">{ratt.namn}</h3>
      <p class="pris text-lg" aria-label={`${ratt.pris} kronor`}>{ratt.pris}:-</p>
    </div>
    {ratt.beskrivning && (
      <p class="text-sm leading-relaxed text-grey-text">
        {ratt.beskrivning}
      </p>
    )}
    <div class="mt-auto flex items-center gap-3 pt-2">
      {ratt.tillval && (
        <>
          <label class="sr-only" for={selectId}>{ratt.tillval.label} för {ratt.namn}</label>
          <select id={selectId} data-tillval class="falt !w-auto grow !py-2 text-sm" required>
            <option value="">Välj {ratt.tillval.label.toLowerCase()}</option>
            {ratt.tillval.alternativ.map((a) => <option value={a}>{a}</option>)}
          </select>
        </>
      )}
      <button type="button" data-lagg-till class="btn-primary ml-auto shrink-0 !px-4 !py-2 text-sm">
        Lägg till
      </button>
    </div>
  </div>
</article>
