---
/**
 * En rad i menylistan. Namn till vänster, pris till höger, beskrivningen
 * dämpad under. Ingen ram och ingen ruta – bara en hårfin linje mellan
 * raderna, som i en tryckt meny.
 */
import type { MenyRatt } from '../config/menu';

interface Props {
  ratt: MenyRatt;
  fordrojning?: number;
}
const { ratt, fordrojning = 0 } = Astro.props;
const selectId = `tillval-${ratt.id}`;
---
<li
  class="border-t border-line first:border-t-0"
  data-menyrad
  data-ratt-id={ratt.id}
  data-reveal
  style={fordrojning ? `--fordrojning: ${fordrojning}ms` : undefined}
>
  <div class="flex items-baseline gap-4 py-5">
    <div class="min-w-0 grow">
      <div class="flex items-baseline gap-3">
        <h3 class="text-[1.15rem] font-medium">{ratt.namn}</h3>
        <span class="h-px grow bg-line" aria-hidden="true"></span>
        <p class="pris accent text-[1.15rem] font-semibold" aria-label={`${ratt.pris} kronor`}>{ratt.pris}</p>
      </div>
      {ratt.beskrivning && <p class="mt-1.5 max-w-lg text-sm text-muted">{ratt.beskrivning}</p>}
      {ratt.tillval && (
        <div class="mt-3">
          <label class="sr-only" for={selectId}>{ratt.tillval.label} för {ratt.namn}</label>
          <select id={selectId} data-tillval class="falt !w-auto !py-1.5 text-sm" required>
            <option value="">Välj {ratt.tillval.label.toLowerCase()}</option>
            {ratt.tillval.alternativ.map((a) => <option value={a}>{a}</option>)}
          </select>
        </div>
      )}
    </div>
    <button
      type="button"
      data-lagg-till
      class="btn-plus mt-1"
      aria-label={`Lägg till ${ratt.namn}`}
    >+</button>
  </div>
</li>
