---
/**
 * Bildyta i väntan på riktiga foton – rätt aspect-ratio redan nu så att
 * layouten inte hoppar när bilderna kommer. Inga stockfoton.
 */
interface Props {
  ratio?: string;
  class?: string;
}
const { ratio = '4/3', class: klass = '' } = Astro.props;
---
<div
  class:list={['flex items-center justify-center rounded-[var(--brand-radie-stor)] border border-line bg-surface', klass]}
  style={`aspect-ratio: ${ratio}`}
  aria-hidden="true"
>
  <span class="text-[0.6rem] tracking-[0.2em] uppercase text-muted">Joe's Bar</span>
</div>
