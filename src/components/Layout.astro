---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import { theme } from '../config/theme';
import { site } from '../config/site';
import Header from './Header.astro';
import Footer from './Footer.astro';
import OrderModal from './OrderModal.astro';
import StickyOrderCTA from './StickyOrderCTA.astro';

interface Props {
  titel: string;
  beskrivning: string;
  /** Stäng av modalen (på själva beställningssidan) */
  utanModal?: boolean;
  jsonLd?: object;
}

const { titel, beskrivning, utanModal = false, jsonLd } = Astro.props;
const f = theme.farger;
const brandCss = `:root{--brand-white:${f.white};--brand-black:${f.black};--brand-surface:${f.surface};--brand-line:${f.line};--brand-muted:${f.muted};--brand-sans:${theme.typsnitt.sans};--brand-radie-liten:${theme.radie.liten};--brand-radie-stor:${theme.radie.stor}}`;
const kanonisk = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beskrivning} />
    <link rel="canonical" href={kanonisk} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {site.sokmotorindexering ? (
      <link rel="sitemap" href="/sitemap-index.xml" />
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:locale" content="sv_SE" />
    <meta name="theme-color" content={f.white} />
    <Fragment set:html={`<style>${brandCss}</style>`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd && <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>`} />}
  </head>
  <body class:list={['flex min-h-svh flex-col', !utanModal && 'pb-[4.75rem] sm:pb-0']}>
    <a
      href="#innehall"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-black focus:px-4 focus:py-2 focus:text-white"
    >Hoppa till innehållet</a>
    <Header />
    <main id="innehall" class="grow">
      <slot />
    </main>
    <Footer />
    {!utanModal && <StickyOrderCTA />}
    {!utanModal && <OrderModal />}
    <script>
      const element = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (poster) => {
            for (const p of poster) {
              if (p.isIntersecting) {
                p.target.classList.add('syns');
                io.unobserve(p.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        element.forEach((el) => io.observe(el));
      } else {
        element.forEach((el) => el.classList.add('syns'));
      }
    </script>
  </body>
</html>
