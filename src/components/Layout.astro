---
import '../styles/global.css';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import { theme } from '../config/theme';
import { site } from '../config/site';
import Header from './Header.astro';
import Footer from './Footer.astro';
import OrderModal from './OrderModal.astro';
import StickyOrderCTA from './StickyOrderCTA.astro';

interface Props {
  titel: string;
  beskrivning: string;
  /** Dölj sticky "Beställ mat"-knappen (på själva beställningssidan) */
  dolBestallCta?: boolean;
  /** Extra JSON-LD att bädda in (sätts av startsidan) */
  jsonLd?: object;
}

const { titel, beskrivning, dolBestallCta = false, jsonLd } = Astro.props;
const f = theme.farger;
const brandCss = `:root{--brand-white:${f.white};--brand-black:${f.black};--brand-grey-light:${f.greyLight};--brand-grey-line:${f.greyLine};--brand-grey-text:${f.greyText};--brand-font-display:${theme.typsnitt.display};--brand-font-body:${theme.typsnitt.body};--brand-radius-kort:${theme.radie.kort};--brand-radius-knapp:${theme.radie.knapp}}`;
const kanonisk = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beskrivning} />
    <link rel="canonical" href={kanonisk} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {site.sokmotorindexering ? (
      <link rel="sitemap" href="/sitemap-index.xml" />
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="preload" as="font" type="font/woff2" href={antonUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={archivoUrl} crossorigin />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:locale" content="sv_SE" />
    <meta name="theme-color" content={f.black} />
    <Fragment set:html={`<style>${brandCss}</style>`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd && <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>`} />}
  </head>
  <body class:list={['min-h-svh flex flex-col', !dolBestallCta && 'pb-20 sm:pb-0']}>
    <a
      href="#innehall"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-black focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:font-bold"
    >Hoppa till innehållet</a>
    <Header />
    <main id="innehall" class="grow">
      <slot />
    </main>
    <Footer />
    {!dolBestallCta && <StickyOrderCTA />}
    {!dolBestallCta && <OrderModal />}
    <script>
      // Diskret fade-in vid scroll – respekterar prefers-reduced-motion via CSS.
      const element = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (poster) => {
            for (const p of poster) {
              if (p.isIntersecting) {
                p.target.classList.add('syns');
                io.unobserve(p.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        element.forEach((el) => io.observe(el));
      } else {
        element.forEach((el) => el.classList.add('syns'));
      }
    </script>
  </body>
</html>
