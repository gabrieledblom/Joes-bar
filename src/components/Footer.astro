---
import { harTelefon, site } from '../config/site';
import { oppettidsRader } from '../lib/hours';
import Logo from './Logo.astro';

const rader = oppettidsRader();
const harAdress = !site.adress.gata.includes('TODO');
---
<footer class="mork">
  <div class="ram grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <Logo variant="staplad" />
      <p class="mt-5 max-w-xs text-sm text-muted">
        Kvarterets restaurang och bar i {site.ort} – husmanskost, burgare,
        kebab och karaoke.
      </p>
    </div>

    <div>
      <p class="etikett">Öppettider</p>
      <dl class="mt-5 text-sm">
        {rader.map((r) => (
          <div class="flex justify-between gap-6 py-1.5">
            <dt class="capitalize text-muted">{r.dag}</dt>
            <dd class="pris">{r.tider}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div>
      <p class="etikett">Kontakt</p>
      <address class="mt-5 text-sm not-italic leading-relaxed text-muted">
        {harAdress ? (
          <>{site.adress.gata}<br />{site.adress.postnummer} {site.adress.postort}</>
        ) : (
          <>{site.ort}<br />Gatuadress publiceras inom kort</>
        )}
      </address>
      <ul class="mt-4 space-y-2 text-sm">
        {harTelefon && <li><a class="lank lank-in" href={`tel:${site.telefonE164}`}>{site.telefon}</a></li>}
        {site.epost && <li><a class="lank lank-in" href={`mailto:${site.epost}`}>{site.epost}</a></li>}
        <li><a class="lank lank-in" href={site.facebook} rel="noopener">Facebook</a></li>
        {site.instagram && <li><a class="lank lank-in" href={site.instagram} rel="noopener">Instagram</a></li>}
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="ram flex flex-wrap items-center justify-between gap-3 py-6 text-xs text-muted">
      <p>© {new Date().getFullYear()} {site.namn}{site.orgnr && ` · Org.nr ${site.orgnr}`}</p>
      <a class="lank lank-in" href="/integritetspolicy">Integritetspolicy</a>
    </div>
  </div>
</footer>
