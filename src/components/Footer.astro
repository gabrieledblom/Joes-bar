---
import { harTelefon, site } from '../config/site';
import { oppettidsRader } from '../lib/hours';
import Checkerboard from './Checkerboard.astro';
import Logo from './Logo.astro';

const rader = oppettidsRader();
const harAdress = !site.adress.gata.includes('TODO');
---
<Checkerboard />
<footer class="pa-svart bg-black text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <Logo variant="staplad" class="text-[1rem]" />
      <p class="mt-4 max-w-xs text-white/75">
        Kvarterets bar och kök i {site.ort} – husmanskost, burgare, kebab och karaoke.
      </p>
      <ul class="mt-4 flex gap-4">
        <li><a class="font-semibold underline underline-offset-4 hover:text-white/70" href={site.facebook} rel="noopener">Facebook</a></li>
        {site.instagram && (
          <li><a class="font-semibold underline underline-offset-4 hover:text-white/70" href={site.instagram} rel="noopener">Instagram</a></li>
        )}
      </ul>
    </div>

    <div>
      <h2 class="font-display text-xl tracking-wide">Öppettider</h2>
      <dl class="mt-4 max-w-xs">
        {rader.map((r) => (
          <div class="flex justify-between gap-6 border-b border-white/25 py-1.5">
            <dt class="capitalize">{r.dag}</dt>
            <dd class="pris">{r.tider}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div>
      <h2 class="font-display text-xl tracking-wide">Hitta hit</h2>
      <address class="mt-4 not-italic leading-relaxed text-white/75">
        {harAdress ? (
          <>
            {site.adress.gata}<br />
            {site.adress.postnummer} {site.adress.postort}
          </>
        ) : (
          <>{site.ort} – gatuadress publiceras inom kort</>
        )}
      </address>
      <ul class="mt-3 space-y-1">
        {harTelefon && (
          <li><a class="underline underline-offset-4 hover:text-white/70" href={`tel:${site.telefonE164}`}>{site.telefon}</a></li>
        )}
        {site.epost && (
          <li><a class="underline underline-offset-4 hover:text-white/70" href={`mailto:${site.epost}`}>{site.epost}</a></li>
        )}
        <li><a class="underline underline-offset-4 hover:text-white/70" href="/om-oss#hitta-hit">Karta & vägbeskrivning</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/25">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-sm text-white/75">
      <p>© {new Date().getFullYear()} {site.namn}{site.orgnr && ` · Org.nr ${site.orgnr}`}</p>
      <a class="underline underline-offset-4 hover:text-white/70" href="/integritetspolicy">Integritetspolicy</a>
    </div>
  </div>
</footer>
