---
/**
 * Klicka-för-att-ladda-karta: ingen tredjepartsladdning förrän besökaren
 * ber om den. TODO: justera koordinaterna när gatuadressen är bekräftad.
 */
import { site } from '../config/site';

const lat = '59.0930'; // TODO: exakt position när adressen finns
const lon = '17.5660';
const osmSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${Number(lon) - 0.01}%2C${Number(lat) - 0.005}%2C${Number(lon) + 0.01}%2C${Number(lat) + 0.005}&layer=mapnik&marker=${lat}%2C${lon}`;
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.namn} ${site.ort}`)}`;
---
<div class="overflow-hidden rounded-[var(--brand-radie-stor)] border border-line">
  <button
    type="button"
    data-karta-knapp
    data-src={osmSrc}
    class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-2 bg-surface transition-colors hover:bg-white"
  >
    <span class="text-sm font-medium">Visa kartan</span>
    <span class="text-xs text-muted">Laddas från OpenStreetMap när du klickar</span>
  </button>
</div>
<p class="mt-4 text-sm">
  <a class="lank lank-in" href={googleMaps} rel="noopener">Vägbeskrivning i Google Maps</a>
</p>
<script>
  document.addEventListener('click', (e) => {
    const knapp = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-karta-knapp]');
    if (!knapp) return;
    const iframe = document.createElement('iframe');
    iframe.src = knapp.dataset.src ?? '';
    iframe.title = 'Karta över Järna';
    iframe.loading = 'lazy';
    iframe.className = 'aspect-[4/3] w-full border-0';
    knapp.replaceWith(iframe);
  });
</script>
