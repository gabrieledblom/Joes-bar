---
/**
 * Helbleed-hero med ordmärket, valfritt foto bakom.
 *
 * Fotot plockas upp automatiskt: lägg en fil som src/assets/hero.jpg
 * (eller .png/.webp/.avif) så hittar bygget den. Astro komprimerar och
 * skalar om den åt oss och genererar srcset, så en stor originalfil gör
 * ingen skada. Finns ingen fil renderas varken bild eller gradient –
 * ingen 404, bara den mörka bottnen.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from './Logo.astro';
import { ordering } from '../config/ordering';
import { site } from '../config/site';

const traffar = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const heroBild = Object.values(traffar)[0]?.default;
---
<!--
  -mt-16 pt-16 drar upp sektionen under den klibbiga headern (h-16) så att
  bilden syns bakom den, medan innehållet ändå centreras rätt.
-->
<section class="hero relative isolate -mt-16 flex min-h-[min(86svh,44rem)] items-center justify-center overflow-hidden bg-ink pt-16">
  {heroBild && (
    <>
      <Image
        src={heroBild}
        alt=""
        aria-hidden="true"
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        format="webp"
        quality={72}
        loading="eager"
        fetchpriority="high"
        class="hero-bild absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <!-- Gradient över fotot: mörkast där texten ligger, så kontrasten håller -->
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.66)_0%,rgba(0,0,0,0.54)_45%,rgba(0,0,0,0.76)_100%)]"
        aria-hidden="true"
      ></div>
    </>
  )}

  <div class="hero-text ram flex flex-col items-center py-24 text-center text-bone">
    <Logo variant="staplad" class="text-[clamp(2.75rem,8vw,5rem)]" />

    <p data-entre style="--fordrojning: 120ms" class="mt-10 max-w-md text-lg leading-relaxed text-bone/85">
      Kvarterets restaurang och bar i {site.ort}. Husmanskost, burgare, kebab
      och sallader – avhämtning på cirka {ordering.forberedelseMin} minuter.
    </p>

    <div data-entre style="--fordrojning: 220ms" class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="/bestall" data-oppna-order class="btn btn-ljus">Beställ mat</a>
      <a href="/meny" class="btn-linje btn-linje-ljus">Se menyn</a>
    </div>
  </div>
</section>
