---
import Logo from './Logo.astro';
---
<header
  data-header
  class="sticky top-0 z-40 border-b border-line bg-white/85 backdrop-blur-md transition-colors duration-300 data-[over-hero]:border-transparent data-[over-hero]:bg-transparent data-[over-hero]:text-white data-[over-hero]:backdrop-blur-none"
>
  <div class="ram flex h-16 items-center gap-6">
    <a href="/" class="shrink-0" aria-label="Joe's Bar – till startsidan">
      <Logo variant="rad" />
    </a>
    <nav aria-label="Huvudmeny" class="ml-auto flex items-center gap-5 text-sm sm:gap-7">
      <a href="/meny" class="lank lank-in hidden sm:inline">Meny</a>
      <a href="/om-oss" class="lank lank-in hidden sm:inline">Om oss</a>
      <span data-open-badge hidden class="hidden items-center gap-2 text-sm text-muted lg:inline-flex"></span>
      <a href="/bestall" data-oppna-order class="btn relative !px-5 !py-2.5 text-sm">
        Beställ
        <span
          data-korg-antal
          hidden
          class="ml-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-white px-1.5 text-xs font-semibold text-black"
          aria-label="antal i varukorgen"
        ></span>
      </a>
    </nav>
  </div>
</header>
<script>
  import { aktivtFonster, dagNamn, formatMinuter, nastaOppning, nuIStockholm } from '../lib/hours';
  import { antalIKorg } from '../lib/cart';

  const badge = document.querySelector<HTMLElement>('[data-open-badge]');
  function uppdateraStatus() {
    if (!badge) return;
    const nu = nuIStockholm();
    const f = aktivtFonster(nu);
    badge.textContent = f
      ? `Öppet till ${formatMinuter(f.stanger)}`
      : (() => {
          const n = nastaOppning(nu);
          return `Öppnar ${n.idag ? 'idag' : dagNamn[n.dag]} ${n.tid}`;
        })();
    badge.hidden = false;
  }
  uppdateraStatus();
  setInterval(uppdateraStatus, 60_000);

  // Headern ligger genomskinlig ovanpå heron och blir vit när man skrollat förbi.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (header && hero) {
    const satt = (over: boolean) => {
      header.toggleAttribute('data-over-hero', over);
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([post]) => satt(Boolean(post?.isIntersecting)),
        { rootMargin: `-${header.offsetHeight}px 0px 0px 0px`, threshold: 0 },
      ).observe(hero);
    }
    satt(true);
  }

  const antalEl = document.querySelector<HTMLElement>('[data-korg-antal]');
  function visaAntal(antal: number) {
    if (!antalEl) return;
    antalEl.hidden = antal === 0;
    antalEl.textContent = String(antal);
  }
  visaAntal(antalIKorg());
  window.addEventListener('korg:andrad', (e) => {
    visaAntal((e as CustomEvent<{ antal: number }>).detail.antal);
  });
</script>
