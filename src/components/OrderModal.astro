---
/**
 * Snabbeställning i ett modalfönster.
 *
 * Öppnas av varje "Beställ mat"-knapp på sajten. Knapparna är riktiga
 * länkar till /bestall, så utan JavaScript fungerar de som vanligt –
 * modalen är en förbättring ovanpå, aldrig ett krav.
 *
 * Använder <dialog showModal()> så webbläsaren sköter fokusfälla,
 * Esc-stängning och inertisering av bakgrunden.
 */
import { meny, synligaKategorier } from '../config/menu';
import { harTelefon, site } from '../config/site';

const kategorier = synligaKategorier();
const ratterI = (id: string) => meny.filter((r) => r.kategori === id && r.tillganglig);
---
<dialog
  data-order-modal
  aria-labelledby="modal-rubrik"
  class="m-auto w-[min(46rem,100vw-1.5rem)] rounded-[var(--brand-radius-kort)] border-2 border-black bg-white p-0 text-black backdrop:bg-black/60 backdrop:backdrop-blur-[2px]"
>
  <div class="flex max-h-[min(85svh,46rem)] flex-col">
    <!-- Rubrikrad -->
    <div class="shrink-0 border-b-2 border-black bg-black text-white pa-svart">
      <div class="flex items-start justify-between gap-4 px-5 py-4 sm:px-6">
        <div>
          <h2 id="modal-rubrik" class="font-display text-2xl tracking-wide sm:text-3xl">Beställ mat</h2>
          <p class="mt-1 text-sm text-white/75">
            Avhämtning i {site.ort} · du betalar när du hämtar
          </p>
        </div>
        <button
          type="button"
          data-modal-stang
          class="-mr-1 -mt-1 shrink-0 rounded-md p-2 text-2xl leading-none transition-colors hover:bg-white hover:text-black"
          aria-label="Stäng beställningen"
        >×</button>
      </div>
      <!-- Kategoriflikar -->
      <div class="flex gap-2 overflow-x-auto px-5 pb-4 sm:px-6" role="tablist" aria-label="Kategorier">
        {kategorier.map((k, i) => (
          <button
            type="button"
            role="tab"
            data-modal-flik={k.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="shrink-0 rounded-full border-2 border-white/40 px-4 py-1.5 text-sm font-semibold whitespace-nowrap transition-colors aria-selected:border-white aria-selected:bg-white aria-selected:text-black hover:border-white"
          >{k.namn}</button>
        ))}
      </div>
    </div>

    <!-- Rätter -->
    <div data-modal-lista class="grow overflow-y-auto overscroll-contain px-5 py-2 sm:px-6">
      {kategorier.map((k, i) => (
        <section data-modal-panel={k.id} hidden={i !== 0} aria-label={k.namn}>
          {k.beskrivning && (
            <p class="border-b border-grey-line py-3 text-sm font-medium text-grey-text">{k.beskrivning}</p>
          )}
          <ul>
            {ratterI(k.id).map((ratt) => (
              <li
                class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-grey-line py-4 last:border-b-0"
                data-modal-ratt
                data-ratt-id={ratt.id}
              >
                <div class="min-w-0 grow">
                  <p class="font-display text-lg tracking-wide">{ratt.namn}</p>
                  {ratt.beskrivning && <p class="mt-0.5 text-sm text-grey-text">{ratt.beskrivning}</p>}
                </div>
                {ratt.tillval && (
                  <>
                    <label class="sr-only" for={`modal-tillval-${ratt.id}`}>
                      {ratt.tillval.label} för {ratt.namn}
                    </label>
                    <select id={`modal-tillval-${ratt.id}`} data-tillval class="falt !w-auto !py-1.5 text-sm">
                      <option value="">Välj {ratt.tillval.label.toLowerCase()}</option>
                      {ratt.tillval.alternativ.map((a) => <option value={a}>{a}</option>)}
                    </select>
                  </>
                )}
                <p class="pris w-16 text-right">{ratt.pris}:-</p>
                <button
                  type="button"
                  data-modal-lagg-till
                  class="btn-primary shrink-0 !px-4 !py-2 text-sm"
                >Lägg till</button>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Summering -->
    <div class="shrink-0 border-t-2 border-black bg-grey-light px-5 py-4 sm:px-6">
      <div data-modal-tom class="text-center">
        <p class="text-sm text-grey-text">Välj något gott från menyn ovan så dyker summan upp här.</p>
      </div>
      <div data-modal-summering hidden class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-sm text-grey-text"><span data-modal-antal>0</span> i korgen</p>
          <p class="pris text-2xl" data-modal-summa>0 kr</p>
        </div>
        <a href="/bestall" class="btn-primary !px-6 !py-3">Till kassan →</a>
      </div>
      {harTelefon && (
        <p class="mt-3 text-center text-xs text-grey-text">
          Hellre prata? Ring {site.telefon}
        </p>
      )}
    </div>
  </div>
</dialog>

<script>
  import { rattMedId } from '../config/menu';
  import { antalIKorg, laggTill, lasKorg } from '../lib/cart';

  const modal = document.querySelector<HTMLDialogElement>('[data-order-modal]');
  if (modal) {
    const flikar = [...modal.querySelectorAll<HTMLButtonElement>('[data-modal-flik]')];
    const paneler = [...modal.querySelectorAll<HTMLElement>('[data-modal-panel]')];
    const tomEl = modal.querySelector<HTMLElement>('[data-modal-tom]')!;
    const summeringEl = modal.querySelector<HTMLElement>('[data-modal-summering]')!;
    const antalEl = modal.querySelector<HTMLElement>('[data-modal-antal]')!;
    const summaEl = modal.querySelector<HTMLElement>('[data-modal-summa]')!;
    let senastFokus: HTMLElement | null = null;

    function visaKategori(id: string) {
      for (const flik of flikar) {
        flik.setAttribute('aria-selected', String(flik.dataset.modalFlik === id));
      }
      for (const panel of paneler) {
        panel.hidden = panel.dataset.modalPanel !== id;
      }
      modal!.querySelector('[data-modal-lista]')!.scrollTop = 0;
    }

    function uppdateraSummering() {
      const rader = lasKorg();
      const summa = rader.reduce((s, r) => s + (rattMedId(r.id)?.pris ?? 0) * r.antal, 0);
      const antal = antalIKorg();
      tomEl.hidden = antal > 0;
      summeringEl.hidden = antal === 0;
      antalEl.textContent = antal === 1 ? '1 rätt' : `${antal} rätter`;
      summaEl.textContent = `${summa} kr`;
    }

    function oppna() {
      senastFokus = document.activeElement as HTMLElement;
      uppdateraSummering();
      modal!.showModal();
    }

    // Alla "Beställ mat"-länkar öppnar modalen i stället för att navigera.
    // Utan JS (eller vid mittenklick/ctrl-klick) fungerar de som vanliga länkar.
    document.addEventListener('click', (e) => {
      const utlosare = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-oppna-order]');
      if (!utlosare) return;
      const me = e as MouseEvent;
      if (me.metaKey || me.ctrlKey || me.shiftKey || me.button !== 0) return;
      e.preventDefault();
      oppna();
    });

    modal.querySelector('[data-modal-stang]')!.addEventListener('click', () => modal.close());

    // Klick på bakgrunden stänger
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    modal.addEventListener('close', () => senastFokus?.focus());

    for (const flik of flikar) {
      flik.addEventListener('click', () => visaKategori(flik.dataset.modalFlik!));
    }

    // Piltangenter mellan flikarna, som en riktig tablist
    modal.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key !== 'ArrowRight' && ke.key !== 'ArrowLeft') return;
      const i = flikar.findIndex((f) => f.getAttribute('aria-selected') === 'true');
      const nasta = flikar[(i + (ke.key === 'ArrowRight' ? 1 : -1) + flikar.length) % flikar.length]!;
      visaKategori(nasta.dataset.modalFlik!);
      nasta.focus();
      e.preventDefault();
    });

    modal.addEventListener('click', (e) => {
      const knapp = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-modal-lagg-till]');
      if (!knapp) return;
      const rad = knapp.closest<HTMLElement>('[data-modal-ratt]')!;
      const id = rad.dataset.rattId!;
      const select = rad.querySelector<HTMLSelectElement>('[data-tillval]');
      if (select && !select.value) {
        select.classList.add('behover-val');
        select.focus();
        select.addEventListener('change', () => select.classList.remove('behover-val'), { once: true });
        return;
      }
      laggTill(id, select?.value || undefined);
      uppdateraSummering();

      const original = knapp.textContent;
      knapp.classList.add('tillagd');
      knapp.textContent = 'Tillagd ✓';
      knapp.disabled = true;
      setTimeout(() => {
        knapp.classList.remove('tillagd');
        knapp.textContent = original;
        knapp.disabled = false;
      }, 900);
    });

    window.addEventListener('korg:andrad', uppdateraSummering);
  }
</script>
