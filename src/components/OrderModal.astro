---
/**
 * Snabbeställning i ett fönster. Öppnas av varje "Beställ"-knapp.
 *
 * Knapparna är riktiga länkar till /bestall, så utan JavaScript – eller
 * vid ctrl/cmd-klick – fungerar de som vanligt. Bygger på
 * <dialog showModal()> så webbläsaren sköter fokusfälla, Esc och att
 * bakgrunden blir inert.
 */
import { meny, synligaKategorier } from '../config/menu';
import { harTelefon, site } from '../config/site';

const kategorier = synligaKategorier();
const ratterI = (id: string) => meny.filter((r) => r.kategori === id && r.tillganglig);
---
<dialog
  data-order-modal
  aria-labelledby="modal-rubrik"
  class="m-auto w-[min(40rem,100vw-2rem)] rounded-[var(--brand-radie-stor)] border border-line bg-white p-0 text-black backdrop:bg-black/25 backdrop:backdrop-blur-[3px]"
>
  <div class="flex max-h-[min(84svh,44rem)] flex-col">
    <div class="shrink-0 border-b border-line px-6 pt-6 pb-4 sm:px-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="modal-rubrik" class="text-2xl font-medium">Beställ mat</h2>
          <p class="mt-1 text-sm text-muted">Avhämtning i {site.ort} · du betalar när du hämtar</p>
        </div>
        <button
          type="button"
          data-modal-stang
          class="-mr-2 -mt-2 shrink-0 rounded p-2 text-xl leading-none text-muted transition-colors hover:text-black"
          aria-label="Stäng"
        >×</button>
      </div>
      <div class="skrollrad mt-5 -mx-1 flex gap-1 px-1" role="tablist" aria-label="Kategorier">
        {kategorier.map((k, i) => (
          <button
            type="button"
            role="tab"
            data-modal-flik={k.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="shrink-0 rounded-full border border-transparent px-3.5 py-1.5 text-sm whitespace-nowrap text-muted transition-colors aria-selected:border-line aria-selected:bg-surface aria-selected:font-medium aria-selected:text-black hover:text-black"
          >{k.namn}</button>
        ))}
      </div>
    </div>

    <div data-modal-lista class="grow overflow-y-auto overscroll-contain px-6 sm:px-8">
      {kategorier.map((k, i) => (
        <section data-modal-panel={k.id} hidden={i !== 0} aria-label={k.namn}>
          {k.beskrivning && <p class="pt-4 text-sm text-muted">{k.beskrivning}</p>}
          <ul>
            {ratterI(k.id).map((ratt) => (
              <li class="border-t border-line first:border-t-0" data-modal-ratt data-ratt-id={ratt.id}>
                <div class="flex items-baseline gap-4 py-4">
                  <div class="min-w-0 grow">
                    <div class="flex items-baseline gap-3">
                      <p class="font-medium">{ratt.namn}</p>
                      <span class="h-px grow bg-line" aria-hidden="true"></span>
                      <span class="pris">{ratt.pris}</span>
                    </div>
                    {ratt.beskrivning && <p class="mt-1 text-sm text-muted">{ratt.beskrivning}</p>}
                    {ratt.tillval && (
                      <div class="mt-2.5">
                        <label class="sr-only" for={`modal-tillval-${ratt.id}`}>
                          {ratt.tillval.label} för {ratt.namn}
                        </label>
                        <select id={`modal-tillval-${ratt.id}`} data-tillval class="falt !w-auto !py-1.5 text-sm">
                          <option value="">Välj {ratt.tillval.label.toLowerCase()}</option>
                          {ratt.tillval.alternativ.map((a) => <option value={a}>{a}</option>)}
                        </select>
                      </div>
                    )}
                  </div>
                  <button
                    type="button"
                    data-modal-lagg-till
                    class="btn-plus mt-0.5"
                    aria-label={`Lägg till ${ratt.namn}`}
                  >+</button>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="shrink-0 border-t border-line bg-surface px-6 py-5 sm:px-8">
      <div data-modal-tom>
        <p class="text-sm text-muted">Välj något från menyn så räknas summan här.</p>
      </div>
      <div data-modal-summering hidden class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-sm text-muted" data-modal-antal>0 rätter</p>
          <p class="pris mt-0.5 text-xl font-medium" data-modal-summa>0 kr</p>
        </div>
        <a href="/bestall" class="btn">Till kassan</a>
      </div>
      {harTelefon && <p class="mt-3 text-xs text-muted">Hellre prata? Ring {site.telefon}</p>}
    </div>
  </div>
</dialog>

<script>
  import { rattMedId } from '../config/menu';
  import { antalIKorg, laggTill, lasKorg } from '../lib/cart';

  const modal = document.querySelector<HTMLDialogElement>('[data-order-modal]');
  if (modal) {
    const flikar = [...modal.querySelectorAll<HTMLButtonElement>('[data-modal-flik]')];
    const paneler = [...modal.querySelectorAll<HTMLElement>('[data-modal-panel]')];
    const tomEl = modal.querySelector<HTMLElement>('[data-modal-tom]')!;
    const summeringEl = modal.querySelector<HTMLElement>('[data-modal-summering]')!;
    const antalEl = modal.querySelector<HTMLElement>('[data-modal-antal]')!;
    const summaEl = modal.querySelector<HTMLElement>('[data-modal-summa]')!;
    let senastFokus: HTMLElement | null = null;

    function visaKategori(id: string) {
      for (const flik of flikar) flik.setAttribute('aria-selected', String(flik.dataset.modalFlik === id));
      for (const panel of paneler) panel.hidden = panel.dataset.modalPanel !== id;
      modal!.querySelector('[data-modal-lista]')!.scrollTop = 0;
    }

    function uppdateraSummering() {
      const summa = lasKorg().reduce((s, r) => s + (rattMedId(r.id)?.pris ?? 0) * r.antal, 0);
      const antal = antalIKorg();
      tomEl.hidden = antal > 0;
      summeringEl.hidden = antal === 0;
      antalEl.textContent = antal === 1 ? '1 rätt' : `${antal} rätter`;
      summaEl.textContent = `${summa} kr`;
    }

    document.addEventListener('click', (e) => {
      const utlosare = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-oppna-order]');
      if (!utlosare) return;
      const me = e as MouseEvent;
      if (me.metaKey || me.ctrlKey || me.shiftKey || me.button !== 0) return;
      e.preventDefault();
      senastFokus = document.activeElement as HTMLElement;
      uppdateraSummering();
      modal.showModal();
    });

    modal.querySelector('[data-modal-stang]')!.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    modal.addEventListener('close', () => senastFokus?.focus());

    for (const flik of flikar) {
      flik.addEventListener('click', () => visaKategori(flik.dataset.modalFlik!));
    }

    modal.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key !== 'ArrowRight' && ke.key !== 'ArrowLeft') return;
      const i = flikar.findIndex((f) => f.getAttribute('aria-selected') === 'true');
      const nasta = flikar[(i + (ke.key === 'ArrowRight' ? 1 : -1) + flikar.length) % flikar.length]!;
      visaKategori(nasta.dataset.modalFlik!);
      nasta.focus();
      e.preventDefault();
    });

    modal.addEventListener('click', (e) => {
      const knapp = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-modal-lagg-till]');
      if (!knapp) return;
      const rad = knapp.closest<HTMLElement>('[data-modal-ratt]')!;
      const select = rad.querySelector<HTMLSelectElement>('[data-tillval]');
      if (select && !select.value) {
        select.classList.add('behover-val');
        select.focus();
        select.addEventListener('change', () => select.classList.remove('behover-val'), { once: true });
        return;
      }
      laggTill(rad.dataset.rattId!, select?.value || undefined);
      uppdateraSummering();

      knapp.classList.add('tillagd');
      knapp.textContent = '✓';
      setTimeout(() => {
        knapp.classList.remove('tillagd');
        knapp.textContent = '+';
      }, 800);
    });

    window.addEventListener('korg:andrad', uppdateraSummering);
  }
</script>
