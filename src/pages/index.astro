---
import AddToCart from '../components/AddToCart.astro';
import Checkerboard from '../components/Checkerboard.astro';
import Layout from '../components/Layout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Marquee from '../components/Marquee.astro';
import MenuCard from '../components/MenuCard.astro';
import { meny } from '../config/menu';
import { ordering } from '../config/ordering';
import { harTelefon, site } from '../config/site';
import { oppettidsRader } from '../lib/hours';
import { restaurangJsonLd } from '../lib/schema';

const populara = meny.filter((r) => r.popular && r.tillganglig).slice(0, 4);
const rader = oppettidsRader();
const harAdress = !site.adress.gata.includes('TODO');
---
<Layout
  titel={`${site.namn} i ${site.ort} – restaurang, bar & avhämtning`}
  beskrivning={`Restaurang och bar i ${site.ort}. Husmanskost, burgare, kebab och sallader – beställ mat för avhämtning online och betala när du hämtar.`}
  jsonLd={restaurangJsonLd()}
>
  <!-- Hero -->
  <section class="pa-svart relative overflow-hidden bg-black text-white">
    <div class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:pt-20 sm:pb-24">
      <p data-entre class="text-sm font-semibold tracking-[0.35em] uppercase text-white/75">
        {site.namn} · {site.tagline}
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-[clamp(2.8rem,9vw,5.5rem)] leading-[0.95]">
        <span data-entre class="block" style="--fordrojning: 90ms">Mat & dryck</span>
        <span data-entre class="block" style="--fordrojning: 180ms">i {site.ort}</span>
      </h1>
      <p data-entre style="--fordrojning: 280ms" class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">
        Kvarterets restaurang och bar – husmanskost, burgare, kebab och sallader.
        Beställ för avhämtning online, klart på cirka {ordering.forberedelseMin} minuter. Du betalar när du hämtar.
      </p>
      <div data-entre style="--fordrojning: 380ms" class="mt-8 flex flex-wrap gap-4">
        <a href="/bestall" data-oppna-order class="btn-primary !px-7 !py-3.5 text-lg">Beställ mat</a>
        <a href="/meny" class="btn-sekundar text-white">Se menyn</a>
      </div>
    </div>
  </section>
  <Marquee />

  <!-- Populära rätter -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:py-20" aria-labelledby="popular-rubrik">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <h2 id="popular-rubrik" class="font-display text-3xl text-black sm:text-4xl">Favoriter från köket</h2>
      <a href="/meny" class="font-semibold text-black underline underline-offset-4 hover:text-grey-text">Hela menyn →</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {populara.map((ratt, i) => <MenuCard ratt={ratt} fordrojning={i * 90} />)}
    </div>
  </section>

  <!-- Öppettider -->
  <section class="pa-svart bg-black text-white" aria-labelledby="oppettider-rubrik">
    <Checkerboard />
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:py-20 lg:grid-cols-2">
      <div data-reveal>
        <h2 id="oppettider-rubrik" class="font-display text-3xl sm:text-4xl">Öppettider</h2>
        <p class="mt-4 max-w-md text-white/75">
          Sista beställning för avhämtning tas emot {ordering.stoppForeStangningMin} minuter före stängning.
        </p>
        <p class="mt-3 max-w-md text-white/75">
          Fredag och lördag har vi öppet till 01:00 – perfekt efter karaoken.
        </p>
      </div>
      <dl class="max-w-md">
        {rader.map((r, i) => (
          <div
            class="flex justify-between gap-6 border-b border-white/25 py-2.5 text-lg"
            data-reveal
            style={`--fordrojning: ${i * 55}ms`}
          >
            <dt class="capitalize">{r.dag}</dt>
            <dd class="pris">{r.tider}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Hitta hit -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:py-20" aria-labelledby="hitta-rubrik">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div data-reveal>
        <h2 id="hitta-rubrik" class="font-display text-3xl text-black sm:text-4xl">Här ligger vi</h2>
        <address class="mt-4 text-lg not-italic leading-relaxed">
          {harAdress ? (
            <>{site.adress.gata}<br />{site.adress.postnummer} {site.adress.postort}</>
          ) : (
            <>Mitt i {site.ort}, söder om Södertälje.<br />Gatuadress publiceras inom kort.</>
          )}
        </address>
        {harTelefon && (
          <p class="mt-3 text-lg">
            <a class="font-semibold text-black underline underline-offset-4 hover:text-grey-text" href={`tel:${site.telefonE164}`}>{site.telefon}</a>
          </p>
        )}
        <p class="mt-6 max-w-md text-grey-text">
          Frågor om menyn, allergier eller större sällskap? Hör av dig så hjälper vi till.
        </p>
      </div>
      <div data-reveal>
        <MapEmbed />
      </div>
    </div>
  </section>

  <AddToCart />
</Layout>
