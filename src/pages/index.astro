---
import AddToCart from '../components/AddToCart.astro';
import Layout from '../components/Layout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import MenuItem from '../components/MenuItem.astro';
import { meny } from '../config/menu';
import { ordering } from '../config/ordering';
import { harTelefon, site } from '../config/site';
import { oppettidsRader } from '../lib/hours';
import { restaurangJsonLd } from '../lib/schema';

const populara = meny.filter((r) => r.popular && r.tillganglig).slice(0, 4);
const rader = oppettidsRader();
const harAdress = !site.adress.gata.includes('TODO');
---
<Layout
  titel={`${site.namn} i ${site.ort} – restaurang, bar & avhämtning`}
  beskrivning={`Restaurang och bar i ${site.ort}. Husmanskost, burgare, kebab och sallader – beställ mat för avhämtning online och betala när du hämtar.`}
  jsonLd={restaurangJsonLd()}
>
  <!-- Hero -->
  <section class="ram pt-20 pb-24 sm:pt-32 sm:pb-32">
    <p data-entre class="etikett">{site.tagline} · {site.ort}</p>
    <!--
      Rubriken animeras med flit inte in: på en vit sida betyder opacity 0
      att skärmen står tom tills animationen är klar, vilket både känns
      trögt och sänker Speed Index rejält. Stödtexterna får röra sig.
    -->
    <h1 class="mt-6 max-w-3xl text-[clamp(2.5rem,7vw,4.5rem)]">
      <span class="block">Kvarterets restaurang</span>
      <span class="block text-muted">och bar i {site.ort}</span>
    </h1>
    <p data-entre style="--fordrojning: 120ms" class="mt-8 max-w-md text-lg leading-relaxed text-muted">
      Husmanskost, burgare, kebab och sallader. Beställ för avhämtning –
      klart på cirka {ordering.forberedelseMin} minuter, du betalar när du hämtar.
    </p>
    <div data-entre style="--fordrojning: 200ms" class="mt-10 flex flex-wrap items-center gap-3">
      <a href="/bestall" data-oppna-order class="btn">Beställ mat</a>
      <a href="/meny" class="btn-linje">Se hela menyn</a>
    </div>
  </section>

  <!-- Ett urval -->
  <section class="ram pb-24 sm:pb-32" aria-labelledby="urval-rubrik">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line pb-5" data-reveal>
      <h2 id="urval-rubrik" class="text-2xl sm:text-3xl">Ett urval</h2>
      <a href="/meny" class="lank lank-in text-sm">Hela menyn</a>
    </div>
    <ul class="mt-2">
      {populara.map((ratt, i) => <MenuItem ratt={ratt} fordrojning={i * 70} />)}
    </ul>
  </section>

  <!-- Öppettider + hitta hit -->
  <section class="ram grid gap-16 pb-24 sm:pb-32 lg:grid-cols-2 lg:gap-24">
    <div data-reveal>
      <p class="etikett">Öppettider</p>
      <dl class="mt-6">
        {rader.map((r) => (
          <div class="flex items-baseline justify-between gap-6 border-t border-line py-3 first:border-t-0">
            <dt class="capitalize">{r.dag}</dt>
            <dd class="pris text-muted">{r.tider}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 max-w-sm text-sm text-muted">
        Sista beställningen för avhämtning tas emot {ordering.stoppForeStangningMin} minuter
        före stängning. Fredag och lördag har vi öppet till 01:00.
      </p>
    </div>

    <div data-reveal>
      <p class="etikett">Hitta hit</p>
      <address class="mt-6 text-lg not-italic leading-relaxed">
        {harAdress ? (
          <>{site.adress.gata}<br />{site.adress.postnummer} {site.adress.postort}</>
        ) : (
          <>Mitt i {site.ort}, söder om Södertälje.<br />
          <span class="text-muted">Gatuadress publiceras inom kort.</span></>
        )}
      </address>
      {harTelefon && (
        <p class="mt-3"><a class="lank lank-in" href={`tel:${site.telefonE164}`}>{site.telefon}</a></p>
      )}
      <div class="mt-8">
        <MapEmbed />
      </div>
    </div>
  </section>

  <AddToCart />
</Layout>
