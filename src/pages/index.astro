---
import AddToCart from '../components/AddToCart.astro';
import Hero from '../components/Hero.astro';
import Layout from '../components/Layout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import MenuItem from '../components/MenuItem.astro';
import { meny } from '../config/menu';
import { ordering } from '../config/ordering';
import { harTelefon, site } from '../config/site';
import { oppettidsRader } from '../lib/hours';
import { restaurangJsonLd } from '../lib/schema';

const populara = meny.filter((r) => r.popular && r.tillganglig).slice(0, 4);
const rader = oppettidsRader();
const harAdress = !site.adress.gata.includes('TODO');
---
<Layout
  titel={`${site.namn} i ${site.ort} – restaurang, bar & avhämtning`}
  beskrivning={`Restaurang och bar i ${site.ort}. Husmanskost, burgare, kebab och sallader – beställ mat för avhämtning online och betala när du hämtar.`}
  jsonLd={restaurangJsonLd()}
>
  <Hero />

  <!-- Ett urval -->
  <section class="ram pt-20 pb-20 sm:pt-28 sm:pb-28" aria-labelledby="urval-rubrik">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div class="regel">
        <p class="etikett">Från köket</p>
        <h2 id="urval-rubrik" class="mt-3 text-3xl sm:text-4xl">Några favoriter</h2>
      </div>
      <a href="/meny" class="lank lank-in pb-1 text-sm">Hela menyn</a>
    </div>
    <ul class="mt-10 border-t border-line">
      {populara.map((ratt, i) => <MenuItem ratt={ratt} fordrojning={i * 70} />)}
    </ul>
  </section>

  <!--
    Mörkt band. Utan det faller sidan rakt ned i platt ljust efter heron
    och tappar all stämning – det här ger rytm och binder ihop de två.
  -->
  <section class="mork" aria-labelledby="oppet-rubrik">
    <div class="ram grid gap-14 py-20 sm:py-28 lg:grid-cols-[1fr_1.1fr] lg:gap-24">
      <div data-reveal>
        <div class="regel">
          <p class="etikett">Öppettider</p>
          <h2 id="oppet-rubrik" class="mt-3 text-3xl sm:text-4xl">Vi har öppet</h2>
        </div>
        <p class="mt-6 max-w-sm leading-relaxed text-muted">
          Sista beställningen för avhämtning tas emot {ordering.stoppForeStangningMin} minuter
          före stängning. Fredag och lördag håller vi öppet till 01:00 – perfekt efter karaoken.
        </p>
        <a href="/bestall" data-oppna-order class="btn mt-8">Beställ mat</a>
      </div>

      <dl data-reveal>
        {rader.map((r, i) => (
          <div
            class="flex items-baseline justify-between gap-6 border-t border-line py-3.5 text-lg first:border-t-0"
            data-reveal
            style={`--fordrojning: ${i * 45}ms`}
          >
            <dt class="capitalize">{r.dag}</dt>
            <dd class="pris" set:html={r.tider === 'Stängt'
              ? '<span class="text-muted">Stängt</span>'
              : `<span class="accent">${r.tider}</span>`} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Hitta hit -->
  <section class="ram grid gap-14 py-20 sm:py-28 lg:grid-cols-2 lg:gap-24" aria-labelledby="hitta-rubrik">
    <div data-reveal>
      <div class="regel">
        <p class="etikett">Hitta hit</p>
        <h2 id="hitta-rubrik" class="mt-3 text-3xl sm:text-4xl">Här ligger vi</h2>
      </div>
      <address class="mt-6 text-lg not-italic leading-relaxed">
        {harAdress ? (
          <>{site.adress.gata}<br />{site.adress.postnummer} {site.adress.postort}</>
        ) : (
          <>Mitt i {site.ort}, söder om Södertälje.<br />
          <span class="text-muted">Gatuadress publiceras inom kort.</span></>
        )}
      </address>
      {harTelefon && (
        <p class="mt-3 text-lg"><a class="lank lank-in" href={`tel:${site.telefonE164}`}>{site.telefon}</a></p>
      )}
      <p class="mt-6 max-w-sm text-sm text-muted">
        Tar du tåget ligger {site.ort} station på promenadavstånd. Med bil
        parkerar du enkelt i närheten.
      </p>
    </div>
    <div data-reveal>
      <MapEmbed />
    </div>
  </section>

  <AddToCart />
</Layout>
