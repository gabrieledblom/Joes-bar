---
import AddToCart from '../components/AddToCart.astro';
import Layout from '../components/Layout.astro';
import MenuItem from '../components/MenuItem.astro';
import { meny, synligaKategorier } from '../config/menu';
import { harTelefon, site } from '../config/site';

const kategorier = synligaKategorier();
const ratterI = (id: string) => meny.filter((r) => r.kategori === id && r.tillganglig);
---
<Layout
  titel={`Meny – ${site.namn} i ${site.ort}`}
  beskrivning={`Hela menyn hos ${site.namn} i ${site.ort}: snacks, husmanskost, burgare, kebab, sallader och dryck. Priser ${site.prisklass}. Beställ för avhämtning.`}
>
  <section class="ram pt-20 pb-12 sm:pt-28">
    <p data-entre class="etikett">Meny</p>
    <h1 class="mt-6 text-[clamp(2.25rem,6vw,3.5rem)]">
      Allt vi lagar
    </h1>
    <p data-entre style="--fordrojning: 100ms" class="mt-6 max-w-md text-muted">
      Alla rätter går att beställa för avhämtning. Du betalar när du hämtar.
    </p>
    <noscript>
      <p class="mt-6 max-w-md border border-line p-4 text-sm">
        Onlinebeställning kräver JavaScript.
        {harTelefon ? ` Ring oss på ${site.telefon} så tar vi din beställning per telefon.` : ' Ring oss så tar vi din beställning per telefon.'}
      </p>
    </noscript>
  </section>

  <nav aria-label="Menykategorier" class="sticky top-16 z-30 border-y border-line bg-white/85 backdrop-blur-md">
    <div class="ram skrollrad -mx-1 flex gap-1 px-1 py-3">
      {kategorier.map((k) => (
        <a
          href={`#${k.id}`}
          class="shrink-0 rounded-full px-3.5 py-1.5 text-sm whitespace-nowrap text-muted transition-colors hover:bg-surface hover:text-black"
        >{k.namn}</a>
      ))}
    </div>
  </nav>

  <div class="ram">
    {kategorier.map((k) => (
      <section id={k.id} class="scroll-mt-32 pt-16" aria-labelledby={`rubrik-${k.id}`}>
        <div class="border-b border-line pb-5" data-reveal>
          <h2 id={`rubrik-${k.id}`} class="text-2xl sm:text-3xl">{k.namn}</h2>
          {k.beskrivning && <p class="mt-2 max-w-xl text-sm text-muted">{k.beskrivning}</p>}
        </div>
        <ul class="mt-2">
          {ratterI(k.id).map((ratt, i) => <MenuItem ratt={ratt} fordrojning={Math.min(i, 5) * 55} />)}
        </ul>
      </section>
    ))}

    <p class="mt-20 max-w-xl text-sm text-muted">
      Allergier eller frågor? Skriv en kommentar i beställningen
      {harTelefon && <> eller ring <a class="lank lank-in text-black" href={`tel:${site.telefonE164}`}>{site.telefon}</a></>} –
      vi hjälper dig att välja rätt.
    </p>
  </div>

  <AddToCart />
</Layout>
