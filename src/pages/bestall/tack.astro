---
import Checkerboard from '../../components/Checkerboard.astro';
import Layout from '../../components/Layout.astro';
import { harTelefon, site } from '../../config/site';

const harAdress = !site.adress.gata.includes('TODO');
---
<Layout
  titel={`Tack för din beställning – ${site.namn}`}
  beskrivning={`Orderbekräftelse från ${site.namn} i ${site.ort}.`}
  dolBestallCta
>
  <section class="pa-svart bg-black text-white">
    <div class="mx-auto max-w-3xl px-4 pt-12 pb-10 sm:pt-16">
      <h1 class="font-display text-[clamp(2.6rem,7vw,4rem)] leading-[0.95]">Tack!</h1>
      <p class="mt-4 text-lg text-white/75">Din beställning är mottagen och bekräftas via SMS.</p>
    </div>
  </section>
  <Checkerboard />

  <div class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <div data-bekraftelse hidden class="rounded-[var(--brand-radius-kort)] border-2 border-grey-line bg-white p-6 sm:p-8">
      <h2 class="font-display text-2xl text-black">Din order</h2>
      <dl class="mt-5 space-y-3 text-lg">
        <div class="flex justify-between gap-4">
          <dt class="font-semibold">Ordernummer</dt>
          <dd class="pris" data-f-ordernummer></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="font-semibold">Hämtas</dt>
          <dd data-f-tid></dd>
        </div>
        <div class="flex justify-between gap-4 border-t border-white/25 pt-3">
          <dt class="font-semibold">Att betala på plats</dt>
          <dd class="pris" data-f-summa></dd>
        </div>
      </dl>
      <p class="mt-6 leading-relaxed">
        Säg ditt namn eller ordernummer i baren så står maten redo.
        {harAdress
          ? ` Du hittar oss på ${site.adress.gata}, ${site.adress.postnummer} ${site.adress.postort}.`
          : ` Du hittar oss mitt i ${site.ort}.`}
      </p>
      <p class="mt-3 text-grey-text">
        Fick du inget SMS inom ett par minuter?
        {harTelefon ? ` Ring oss på ${site.telefon}.` : ' Ring oss så kollar vi direkt.'}
      </p>
    </div>

    <div data-ingen-order hidden class="rounded-[var(--brand-radius-kort)] border-2 border-dashed border-grey-line p-8 text-center">
      <p class="text-lg font-semibold">Här var det tomt.</p>
      <p class="mt-1 text-grey-text">Vi hittar ingen aktiv beställning i den här webbläsaren.</p>
      <a href="/meny" class="btn-primary mt-5">Till menyn</a>
    </div>
  </div>

  <script>
    const bekraftelse = document.querySelector<HTMLElement>('[data-bekraftelse]')!;
    const ingenOrder = document.querySelector<HTMLElement>('[data-ingen-order]')!;
    try {
      const data = JSON.parse(sessionStorage.getItem('jb-bekraftelse') ?? 'null');
      if (data && typeof data.ordernummer === 'string') {
        bekraftelse.hidden = false;
        bekraftelse.querySelector('[data-f-ordernummer]')!.textContent = `#${data.ordernummer}`;
        bekraftelse.querySelector('[data-f-tid]')!.textContent = `kl ${data.tid}`;
        bekraftelse.querySelector('[data-f-summa]')!.textContent = `${data.summa} kr`;
      } else {
        ingenOrder.hidden = false;
      }
    } catch {
      ingenOrder.hidden = false;
    }
  </script>
</Layout>
