---
import Layout from '../../components/Layout.astro';
import { harTelefon, site } from '../../config/site';

const harAdress = !site.adress.gata.includes('TODO');
---
<Layout
  titel={`Tack för din beställning – ${site.namn}`}
  beskrivning={`Orderbekräftelse från ${site.namn} i ${site.ort}.`}
  utanModal
>
  <section class="ram max-w-xl pt-20 pb-16 sm:pt-28">
    <div data-bekraftelse hidden>
      <p class="etikett">Beställning mottagen</p>
      <h1 class="mt-6 text-[clamp(2rem,5vw,3rem)]">Tack!</h1>
      <p class="mt-5 text-lg text-muted">Din beställning är mottagen och bekräftas via SMS.</p>

      <dl class="mt-12">
        <div class="flex items-baseline justify-between gap-6 border-t border-line py-4">
          <dt class="text-muted">Ordernummer</dt>
          <dd class="pris text-lg font-medium" data-f-ordernummer></dd>
        </div>
        <div class="flex items-baseline justify-between gap-6 border-t border-line py-4">
          <dt class="text-muted">Hämtas</dt>
          <dd class="text-lg" data-f-tid></dd>
        </div>
        <div class="flex items-baseline justify-between gap-6 border-t border-line py-4">
          <dt class="text-muted">Att betala på plats</dt>
          <dd class="pris text-lg font-medium" data-f-summa></dd>
        </div>
      </dl>

      <p class="mt-10 leading-relaxed text-muted">
        Säg ditt namn eller ordernummer i baren så står maten redo.
        {harAdress
          ? ` Du hittar oss på ${site.adress.gata}, ${site.adress.postnummer} ${site.adress.postort}.`
          : ` Du hittar oss mitt i ${site.ort}.`}
      </p>
      <p class="mt-4 text-sm text-muted">
        Fick du inget SMS inom ett par minuter?
        {harTelefon ? ` Ring oss på ${site.telefon}.` : ' Ring oss så kollar vi direkt.'}
      </p>
    </div>

    <div data-ingen-order hidden>
      <p class="etikett">Ingen aktiv beställning</p>
      <h1 class="mt-6 text-[clamp(2rem,5vw,3rem)]">Här var det tomt</h1>
      <p class="mt-5 text-muted">Vi hittar ingen beställning i den här webbläsaren.</p>
      <a href="/meny" class="btn mt-8">Till menyn</a>
    </div>
  </section>

  <script>
    const bekraftelse = document.querySelector<HTMLElement>('[data-bekraftelse]')!;
    const ingenOrder = document.querySelector<HTMLElement>('[data-ingen-order]')!;
    try {
      const data = JSON.parse(sessionStorage.getItem('jb-bekraftelse') ?? 'null');
      if (data && typeof data.ordernummer === 'string') {
        bekraftelse.hidden = false;
        bekraftelse.querySelector('[data-f-ordernummer]')!.textContent = `#${data.ordernummer}`;
        bekraftelse.querySelector('[data-f-tid]')!.textContent = `kl ${data.tid}`;
        bekraftelse.querySelector('[data-f-summa]')!.textContent = `${data.summa} kr`;
      } else {
        ingenOrder.hidden = false;
      }
    } catch {
      ingenOrder.hidden = false;
    }
  </script>
</Layout>
