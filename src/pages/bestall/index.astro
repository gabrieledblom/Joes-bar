---
import Checkerboard from '../../components/Checkerboard.astro';
import Layout from '../../components/Layout.astro';
import { harTelefon, site } from '../../config/site';
---
<Layout
  titel={`Beställ mat – ${site.namn} i ${site.ort}`}
  beskrivning={`Beställ mat för avhämtning hos ${site.namn} i ${site.ort}. Välj tid, få bekräftelse via SMS och betala när du hämtar.`}
  dolBestallCta
>
  <section class="pa-svart bg-black text-white">
    <div class="mx-auto max-w-3xl px-4 pt-12 pb-10 sm:pt-16">
      <h1 class="font-display text-[clamp(2.6rem,7vw,4rem)] leading-[0.95]">Beställ mat</h1>
      <p class="mt-4 text-lg text-white/75">
        Avhämtning hos oss i {site.ort}. <strong>Du betalar när du hämtar</strong> – ingen betalning online.
      </p>
    </div>
  </section>
  <Checkerboard />

  <div class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <script is:inline>
      // Körs synkront under parsning: avgör tom/fylld korg FÖRE första
      // målningen så att sektionerna inte hoppar in efteråt (CLS).
      try {
        var jbKorg = JSON.parse(sessionStorage.getItem('jb-korg') || '[]');
        document.documentElement.dataset.korg = Array.isArray(jbKorg) && jbKorg.length ? 'fylld' : 'tom';
      } catch (e) {
        document.documentElement.dataset.korg = 'tom';
      }
    </script>
    <noscript>
      <div class="rounded-[var(--brand-radius-kort)] border-2 border-grey-line bg-white p-6">
        <h2 class="font-display text-2xl text-black">Onlinebeställning kräver JavaScript</h2>
        <p class="mt-2">
          {harTelefon
            ? `Ring oss på ${site.telefon} så tar vi din beställning per telefon.`
            : 'Ring oss så tar vi din beställning per telefon – numret hittar du på vår Facebook-sida.'}
        </p>
      </div>
    </noscript>

    <!-- Varukorgen -->
    <section aria-labelledby="korg-rubrik" data-js-behov>
      <h2 id="korg-rubrik" class="font-display text-2xl text-black sm:text-3xl">Din varukorg</h2>

      <div data-korg-tom class="mt-5 rounded-[var(--brand-radius-kort)] border-2 border-dashed border-grey-line p-8 text-center">
        <p class="text-lg font-semibold">Korgen är tom.</p>
        <p class="mt-1 text-grey-text">Lägg till något gott från menyn först.</p>
        <a href="/meny" class="btn-primary mt-5">Till menyn</a>
      </div>

      <div data-korg-innehall class="mt-5">
        <ul data-korg-rader class="min-h-40 divide-y divide-grey-line rounded-[var(--brand-radius-kort)] border-2 border-grey-line bg-white"></ul>
        <p class="mt-4 flex items-baseline justify-between text-xl">
          <span class="font-semibold">Summa</span>
          <span class="pris" data-korg-summa>–</span>
        </p>
        <p class="mt-1 text-sm text-grey-text">Betalas på plats vid avhämtning.</p>
      </div>
    </section>

    <!-- Utcheckning -->
    <section aria-labelledby="utcheckning-rubrik" data-utcheckning class="mt-12">
      <h2 id="utcheckning-rubrik" class="font-display text-2xl text-black sm:text-3xl">Dina uppgifter</h2>

      <div class="relative mt-5">
        <div
          data-last-meddelande
          hidden
          class="pa-svart absolute inset-0 z-10 rounded-[var(--brand-radius-kort)] bg-black/95 p-6 text-lg font-semibold text-white"
          role="status"
        ></div>

        <form data-order-form novalidate class="space-y-5">
        <fieldset data-falt class="space-y-5 disabled:opacity-60">
          <div>
            <label for="namn" class="mb-1.5 block font-semibold">Namn</label>
            <input id="namn" name="namn" type="text" class="falt" autocomplete="name" maxlength="60" required />
            <p data-fel-for="namn" class="faltfel mt-1" hidden></p>
          </div>
          <div>
            <label for="mobil" class="mb-1.5 block font-semibold">Mobilnummer</label>
            <input
              id="mobil" name="mobil" type="tel" class="falt" autocomplete="tel"
              placeholder="07X-XXX XX XX" maxlength="17" required
              aria-describedby="mobil-hjalp"
            />
            <p id="mobil-hjalp" class="mt-1 text-sm text-grey-text">Orderbekräftelsen skickas hit via SMS.</p>
            <p data-fel-for="mobil" class="faltfel mt-1" hidden></p>
          </div>
          <div>
            <label for="tid" class="mb-1.5 block font-semibold">Avhämtningstid</label>
            <select id="tid" name="tid" class="falt" required></select>
            <p data-fel-for="tid" class="faltfel mt-1" hidden></p>
          </div>
          <div>
            <label for="kommentar" class="mb-1.5 block font-semibold">
              Kommentar <span class="font-normal text-grey-text">(valfritt – t.ex. allergier)</span>
            </label>
            <textarea id="kommentar" name="kommentar" class="falt" rows="3" maxlength="300"></textarea>
          </div>

          <!-- Honeypot: människor ser eller fyller aldrig i det här fältet -->
          <div class="absolute -left-[9999px] top-auto" aria-hidden="true">
            <label for="webbplats">Lämna det här fältet tomt</label>
            <input id="webbplats" name="webbplats" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div
            data-form-fel
            role="alert"
            aria-live="assertive"
            hidden
            class="rounded-md border-2 border-[#b3261e] bg-white p-4 font-semibold text-[#8c1d16]"
          ></div>

          <button type="submit" data-skicka class="btn-primary w-full !py-3.5 text-lg">
            Skicka beställning
          </button>
          <p class="text-center text-sm text-grey-text">
            Genom att beställa godkänner du att vi hanterar dina uppgifter enligt vår
            <a class="underline underline-offset-4" href="/integritetspolicy">integritetspolicy</a>.
          </p>
        </fieldset>
        </form>
      </div>
    </section>
  </div>

  <style is:global>
    /* Utan JS: visa bara noscript-blocket. Med JS: tom/fylld avgörs före paint. */
    html:not(.js) [data-js-behov],
    html:not(.js) [data-utcheckning],
    html[data-korg='tom'] [data-korg-innehall],
    html[data-korg='tom'] [data-utcheckning],
    html[data-korg='fylld'] [data-korg-tom] {
      display: none;
    }
  </style>

  <script>
    import { rattMedId } from '../../config/menu';
    import { ordering } from '../../config/ordering';
    import { andraAntal, lasKorg, tomKorg, type KorgRad } from '../../lib/cart';
    import { arOppenNu, dagNamn, hamtningsSlottar, nastaOppning, nuIStockholm } from '../../lib/hours';
    import { normaliseraMobil } from '../../lib/phone';
    import { beraknaOrder } from '../../lib/pricing';

    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const raderEl = $('[data-korg-rader]');
    const summaEl = $('[data-korg-summa]');
    const lastMeddelande = $('[data-last-meddelande]');
    const form = $<HTMLFormElement>('[data-order-form]');
    const falt = $<HTMLFieldSetElement>('[data-falt]');
    const tidSelect = $<HTMLSelectElement>('#tid');
    const formFel = $('[data-form-fel]');
    const skickaKnapp = $<HTMLButtonElement>('[data-skicka]');


    function visaFaltfel(namn: string, text: string | null) {
      const el = document.querySelector<HTMLElement>(`[data-fel-for="${namn}"]`);
      const input = document.getElementById(namn);
      if (!el) return;
      el.hidden = !text;
      el.textContent = text ?? '';
      input?.classList.toggle('har-fel', Boolean(text));
      if (text) input?.setAttribute('aria-invalid', 'true');
      else input?.removeAttribute('aria-invalid');
    }

    function renderaKorg() {
      const rader = lasKorg();
      document.documentElement.dataset.korg = rader.length ? 'fylld' : 'tom';
      if (rader.length === 0) return;

      raderEl.textContent = '';
      let summa = 0;
      rader.forEach((rad: KorgRad, index: number) => {
        const ratt = rattMedId(rad.id);
        if (!ratt) return;
        summa += ratt.pris * rad.antal;

        const li = document.createElement('li');
        li.className = 'flex items-center gap-3 p-4';

        const info = document.createElement('div');
        info.className = 'grow';
        const namn = document.createElement('p');
        namn.className = 'font-semibold';
        namn.textContent = ratt.namn;
        info.append(namn);
        if (rad.tillval) {
          const t = document.createElement('p');
          t.className = 'text-sm text-grey-text';
          t.textContent = rad.tillval;
          info.append(t);
        }

        const stegare = document.createElement('div');
        stegare.className = 'flex items-center gap-1';
        const minus = document.createElement('button');
        minus.type = 'button';
        minus.className = 'h-9 w-9 rounded-md border-2 border-grey-line font-bold hover:bg-white';
        minus.textContent = '−';
        minus.setAttribute('aria-label', `Minska antal ${ratt.namn}`);
        minus.addEventListener('click', () => { andraAntal(index, -1); renderaKorg(); });
        const antal = document.createElement('span');
        antal.className = 'w-8 text-center font-bold tabular-nums';
        antal.textContent = String(rad.antal);
        const plus = document.createElement('button');
        plus.type = 'button';
        plus.className = 'h-9 w-9 rounded-md border-2 border-grey-line font-bold hover:bg-white';
        plus.textContent = '+';
        plus.setAttribute('aria-label', `Öka antal ${ratt.namn}`);
        plus.addEventListener('click', () => { andraAntal(index, 1); renderaKorg(); });
        stegare.append(minus, antal, plus);

        const pris = document.createElement('p');
        pris.className = 'pris w-20 text-right';
        pris.textContent = `${ratt.pris * rad.antal}:-`;

        li.append(info, stegare, pris);
        raderEl.append(li);
      });
      summaEl.textContent = `${summa} kr`;
    }

    function fyllTider() {
      const nu = nuIStockholm();
      const slottar = hamtningsSlottar(nu);
      const tidigareVal = tidSelect.value;
      tidSelect.textContent = '';

      if (!ordering.aktiv) {
        lasFormular('Onlinebeställningen är tillfälligt stängd. Ring oss så hjälper vi dig direkt.');
        return;
      }
      if (slottar.length === 0) {
        const n = nastaOppning(nu);
        const nar = `${n.idag ? 'idag' : dagNamn[n.dag]} kl ${n.tid}`;
        lasFormular(
          arOppenNu(nu)
            ? `Köket har stängt för fler beställningar i kväll. Vi tar emot beställningar igen ${nar}.`
            : `Vi öppnar igen ${nar}. Välkommen tillbaka då – eller ring oss för frågor.`,
        );
        return;
      }

      lastMeddelande.hidden = true;
      falt.disabled = false;
      const valj = document.createElement('option');
      valj.value = '';
      valj.textContent = 'Välj tid';
      tidSelect.append(valj);
      for (const s of slottar) {
        const o = document.createElement('option');
        o.value = s.value;
        o.textContent = s.label;
        tidSelect.append(o);
      }
      if (tidigareVal && slottar.some((s) => s.value === tidigareVal)) tidSelect.value = tidigareVal;
    }

    function lasFormular(text: string) {
      lastMeddelande.hidden = false;
      lastMeddelande.textContent = text;
      falt.disabled = true;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formFel.hidden = true;

      const namn = $<HTMLInputElement>('#namn').value.trim();
      const mobilRatt = $<HTMLInputElement>('#mobil').value;
      const mobil = normaliseraMobil(mobilRatt);
      const tid = tidSelect.value;
      const kommentar = $<HTMLTextAreaElement>('#kommentar').value.trim();
      const honeypot = $<HTMLInputElement>('#webbplats').value;
      const rader = lasKorg();

      let ok = true;
      if (namn.length < 2) { visaFaltfel('namn', 'Skriv ditt namn så vi kan ropa upp beställningen.'); ok = false; }
      else visaFaltfel('namn', null);
      if (!mobil) { visaFaltfel('mobil', 'Ange ett svenskt mobilnummer, t.ex. 070-123 45 67.'); ok = false; }
      else visaFaltfel('mobil', null);
      if (!tid) { visaFaltfel('tid', 'Välj när du vill hämta maten.'); ok = false; }
      else visaFaltfel('tid', null);
      const berakning = beraknaOrder(rader);
      if (!berakning.ok) {
        formFel.hidden = false;
        formFel.textContent = berakning.fel;
        ok = false;
      }
      if (!ok) return;

      skickaKnapp.disabled = true;
      const originaltext = skickaKnapp.textContent;
      skickaKnapp.textContent = 'Skickar …';
      try {
        const svar = await fetch('/api/order', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ namn, mobil, pickupAt: tid, kommentar, webbplats: honeypot, rader }),
        });
        const data = await svar.json().catch(() => null);
        if (svar.ok && data?.ok) {
          sessionStorage.setItem('jb-bekraftelse', JSON.stringify(data));
          tomKorg();
          location.assign('/bestall/tack');
          return;
        }
        formFel.hidden = false;
        formFel.textContent =
          data?.fel ?? 'Något gick fel och beställningen kom inte fram. Försök igen eller ring oss.';
      } catch {
        formFel.hidden = false;
        formFel.textContent = 'Vi fick ingen kontakt med servern. Kontrollera uppkopplingen och försök igen – eller ring oss.';
      }
      skickaKnapp.disabled = false;
      skickaKnapp.textContent = originaltext;
    });

    renderaKorg();
    fyllTider();
    setInterval(fyllTider, 60_000);
  </script>
</Layout>
