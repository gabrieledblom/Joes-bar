---
import Layout from '../components/Layout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Placeholder from '../components/Placeholder.astro';
import { harTelefon, site } from '../config/site';

const harAdress = !site.adress.gata.includes('TODO');
---
<Layout
  titel={`Om oss – ${site.namn} i ${site.ort}`}
  beskrivning={`${site.namn} är kvarterets restaurang och bar i ${site.ort} – mat, dryck, karaoke och livekvällar. Hitta hit och kontakta oss.`}
>
  <section class="ram pt-20 pb-20 sm:pt-28">
    <p data-entre class="etikett">Om oss</p>
    <h1 class="mt-6 max-w-2xl text-[clamp(2.25rem,6vw,3.5rem)]">
      Kvarterets vardagsrum
    </h1>
    <p data-entre style="--fordrojning: 100ms" class="mt-8 max-w-xl text-lg leading-relaxed text-muted">
      {site.namn} är stället i {site.ort} där du käkar en riktig middag, tar något
      i baren och blir kvar när karaoken drar i gång. Enkelt, varmt och utan
      krångel – mat och dryck som det låter.
    </p>
  </section>

  <hr class="linje" />

  <section class="ram grid gap-12 py-20 lg:grid-cols-2 lg:gap-24" aria-labelledby="karaoke-rubrik">
    <div data-reveal>
      <p class="etikett">Kvällarna</p>
      <h2 id="karaoke-rubrik" class="mt-5 text-2xl sm:text-3xl">Karaoke och livemusik</h2>
      <p class="mt-6 max-w-md leading-relaxed text-muted">
        På helgerna blir det karaoke och dans – fredagar och lördagar har vi
        öppet till 01:00. Håll utkik på vår
        <a class="lank lank-in text-ink" href={site.facebook} rel="noopener">Facebook-sida</a>
        för kvällens tema och kommande livekvällar.
      </p>
      <p class="mt-4 max-w-md leading-relaxed text-muted">
        Kom hungrig: köket serverar hela kvällen, och sugna sällskap kan
        beställa in snacks till bordet.
      </p>
    </div>
    <div data-reveal>
      <Placeholder ratio="4/3" />
    </div>
  </section>

  <hr class="linje" />

  <section class="ram py-20" aria-labelledby="kontakt-rubrik">
    <p class="etikett">Kontakt</p>
    <h2 id="kontakt-rubrik" class="sr-only">Kontaktuppgifter</h2>
    <dl class="mt-6 grid gap-8 sm:grid-cols-3">
      <div data-reveal>
        <dt class="text-sm text-muted">Telefon</dt>
        <dd class="mt-1.5 text-lg">
          {harTelefon
            ? <a class="lank lank-in" href={`tel:${site.telefonE164}`}>{site.telefon}</a>
            : <span class="text-muted">Publiceras inom kort</span>}
        </dd>
      </div>
      <div data-reveal style="--fordrojning: 70ms">
        <dt class="text-sm text-muted">E-post</dt>
        <dd class="mt-1.5 text-lg">
          {site.epost
            ? <a class="lank lank-in" href={`mailto:${site.epost}`}>{site.epost}</a>
            : <span class="text-muted">Publiceras inom kort</span>}
        </dd>
      </div>
      <div data-reveal style="--fordrojning: 140ms">
        <dt class="text-sm text-muted">Sociala medier</dt>
        <dd class="mt-1.5 text-lg">
          <a class="lank lank-in" href={site.facebook} rel="noopener">Facebook</a>
          {site.instagram && <> · <a class="lank lank-in" href={site.instagram} rel="noopener">Instagram</a></>}
        </dd>
      </div>
    </dl>
  </section>

  <hr class="linje" />

  <section id="hitta-hit" class="ram scroll-mt-24 py-20" aria-labelledby="hitta-rubrik">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <p class="etikett">Hitta hit</p>
        <h2 id="hitta-rubrik" class="mt-5 text-2xl sm:text-3xl">Här ligger vi</h2>
        <address class="mt-6 text-lg not-italic leading-relaxed">
          {harAdress ? (
            <>{site.adress.gata}<br />{site.adress.postnummer} {site.adress.postort}</>
          ) : (
            <>Mitt i {site.ort}, söder om Södertälje.<br />
            <span class="text-muted">Gatuadress publiceras inom kort.</span></>
          )}
        </address>
        <p class="mt-6 max-w-sm text-sm text-muted">
          Tar du tåget ligger {site.ort} station på promenadavstånd. Med bil
          parkerar du enkelt i närheten.
        </p>
      </div>
      <div data-reveal>
        <MapEmbed />
      </div>
    </div>
  </section>
</Layout>
