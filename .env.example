# =============================================================================
# Joe's Bar - miljovariabler
# =============================================================================
# Kopiera till .env.local for lokal utveckling. I drift laggs allt in i
# Vercel: Project -> Settings -> Environment Variables. Aldrig i repot.
#
# Sajten startar aven om det mesta har ar tomt. Det som saknas stangs av med
# ett tydligt meddelande i stallet for att latsas fungera.
# =============================================================================

# --- Stripe ------------------------------------------------------------------
# Stripe Dashboard -> Developers -> API keys. Borja i testlage (sk_test_...).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Skapas NAR webhooken registreras i Stripe Dashboard -> Developers ->
# Webhooks, med endpoint https://DIN-DOMAN/api/webhooks/stripe
# Det gar alltsa forst EFTER forsta deployen. Se README, "Driftsattning i
# ratt ordning". Utan den blir ingen order betald och koket ser ingenting.
STRIPE_WEBHOOK_SECRET=

# --- Databas -----------------------------------------------------------------
# Neon (neon.tech) eller Vercel Postgres. Anslutningsstrangen far du nar
# databasen skapas. Lamnas den tom anvands ett minneslage som forsvinner vid
# omstart - bara for lokal utveckling, aldrig i drift.
DATABASE_URL=

# --- SMS-kvitto via 46elks ---------------------------------------------------
# 46elks.se -> Dashboard -> API. Utan nycklar loggas sms:et i stallet for
# att skickas.
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
# Avsandarnamn, max 11 tecken.
ELKS_SMS_FROM=JoesBar

# --- E-postkvitto via Resend -------------------------------------------------
# resend.com -> API Keys. Domanen maste verifieras hos Resend forst.
RESEND_API_KEY=
RESEND_FROM="Joe's Bar <kvitto@joesbar.se>"

# --- Koksskarmen -------------------------------------------------------------
# Losenordet personalen anvander pa /kok. Valj sjalv, minst 12 tecken.
KITCHEN_DASHBOARD_PASSWORD=

# --- Sajtens adress ----------------------------------------------------------
# Anvands i Stripes aterkomst-URL och i lankar i kvitton. Utan protokoll
# fungerar det inte. Lokalt: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://joesbar.se
