# 46elks API-uppgifter (https://46elks.se/ -> Dashboard -> API).
# Utan dessa kors SMS i mock-lage: innehallet loggas i funktionsloggen
# i stallet for att skickas. Laggs in i Vercel: Project Settings ->
# Environment Variables. ALDRIG i repot.
ELKS_API_USERNAME=
ELKS_API_PASSWORD=

# Mobilnummer som tar emot order-SMS till restaurangen (E.164-format).
# Overstyr telefonnumret i src/config/site.ts for just SMS-mottagning.
ORDER_SMS_TO=+467XXXXXXXX

# Orderlogg + rate limit: lagg till "Upstash for Redis" via Vercel
# Marketplace sa injiceras dessa automatiskt i projektet. Lokalt kan de
# lamnas tomma - da anvands ett in-memory-fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
